# --- Common -----------------------------------------------------------------
# Transport: stdio (local, default) or http (hosted multi-tenant).
KAMINARI_CLICK_TRANSPORT=stdio
# Kaminari Click API base URL.
KAMINARI_CLICK_API_URL=https://kaminari.click
# Optional HS256 secret (UI AUTH_JWTKEY). When set, agent JWTs are signature-verified.
#KAMINARI_CLICK_JWT_KEY=
#KAMINARI_CLICK_JWT_ALG=HS256
# Log level: trace | debug | info | warn | error | fatal.
KAMINARI_CLICK_LOG_LEVEL=info
# Log format: pretty (default for stdio) | json (default for http).
#KAMINARI_CLICK_LOG_FORMAT=json

# --- stdio only -------------------------------------------------------------
# MCP / Agent token from Kaminari Click Account Settings (not the regular API token).
# FORBIDDEN in http mode (tenant isolation).
KAMINARI_CLICK_API_KEY=

# --- http only --------------------------------------------------------------
KAMINARI_CLICK_HTTP_PORT=8080
# Per-token rate limit, requests per minute.
KAMINARI_CLICK_RATE_LIMIT_RPM=120
# Public URLs advertised in the OAuth discovery documents.
KAMINARI_CLICK_OAUTH_ISSUER_URL=https://mcp.kaminari.click
KAMINARI_CLICK_OAUTH_RESOURCE=https://mcp.kaminari.click/mcp
KAMINARI_CLICK_OAUTH_RESOURCE_METADATA_URL=https://mcp.kaminari.click/.well-known/oauth-protected-resource
