{
  "name": "@kaminari-click/mcp",
  "version": "0.1.2",
  "description": "Official Model Context Protocol (MCP) server for Kaminari Click — traffic-quality statistics, saved reports, shared reports, and IP/UA reference databases.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kaminari-click",
    "antifraud",
    "ivt",
    "traffic-quality",
    "cursor",
    "claude",
    "chatgpt"
  ],
  "homepage": "https://github.com/kaminari-click/mcp",
  "bugs": {
    "url": "https://github.com/kaminari-click/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaminari-click/mcp.git"
  },
  "license": "MIT",
  "author": "Kaminari Click <support@kaminari.click> (https://kaminari.click)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "kaminari-click-mcp": "./dist/bin.js"
  },
  "main": "./dist/bin.js",
  "sideEffects": false,
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "prebuild": "npm run sync-version",
    "pretest": "npm run sync-version",
    "version": "npm run sync-version && git add src/shared/version.ts manifest.json server.json",
    "build": "tsup",
    "build:mcpb-bundle": "tsup --config tsup.mcpb.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:cov && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "neverthrow": "8.1.1",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.10.5",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.0.1",
    "prettier": "3.4.2",
    "tsup": "8.5.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "4.1.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
